# Копия шаблона для локальной разработки: скопируйте в .env и задайте свои значения

# Администратор веб-интерфейса
WEB_USER=admin
WEB_PASS=change_me

# Публичный хост/IP сервера для генерации SRT-ссылок в UI.
# Если пусто — будет использован hostname из браузера.
PUBLIC_HOST=

# Ключ SLS API (должен совпадать с api_keys в files/sls.conf)
SLS_API_KEY=belabox_sls_api_key_2026
